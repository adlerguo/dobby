POSTGRES_USER=app
# 开发默认值；生产环境必须改为强随机口令。
POSTGRES_PASSWORD=pass
POSTGRES_DB=eap
DATABASE_URL=postgresql+psycopg://app:pass@postgres:5432/eap
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
# 开发默认值；生产环境必须改为强随机账号和口令。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_KEY=minioadmin
MINIO_SECRET=minioadmin
MAAS_BASE_URL=http://maas:8100
SANDBOX_BASE_URL=http://sandbox:8200
# JWT_SECRET 留空由首次启动自动生成，切勿手填弱值；已有部署必须继续使用原密钥。
# JWT_SECRET=
AUTO_GENERATE_SECRETS=true
JWT_ACCESS_TTL=3600
# MAAS_ENCRYPTION_KEY 留空由首次启动自动生成，切勿手填弱值；已有加密数据必须继续使用原密钥。
# MAAS_ENCRYPTION_KEY=
PRODUCTION_MODE=true
