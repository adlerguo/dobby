POSTGRES_USER=app
# 开发默认值；生产环境必须改为强随机口令。
POSTGRES_PASSWORD=pass
POSTGRES_DB=eap
DATABASE_URL=postgresql+psycopg://app:pass@postgres:5432/eap
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
# 开发默认值；生产环境必须改为强随机账号和口令。
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_KEY=minioadmin
MINIO_SECRET=minioadmin
MAAS_BASE_URL=http://maas:8100
SANDBOX_BASE_URL=http://sandbox:8200
# JWT_SECRET 留空由首次启动自动生成，切勿手填弱值；已有部署必须继续使用原密钥。
# JWT_SECRET=
AUTO_GENERATE_SECRETS=true
JWT_ACCESS_TTL=3600
# MAAS_ENCRYPTION_KEY 留空由首次启动自动生成，切勿手填弱值；已有加密数据必须继续使用原密钥。
# MAAS_ENCRYPTION_KEY=
PRODUCTION_MODE=true
# 最大请求体字节数，默认 2097152（2MB），可按部署需要调大或调小。
MAX_REQUEST_BODY_BYTES=2097152
SEED_DEMO_MODE=false
# 默认关闭智能体自动执行 code/python/shell/sandbox 类工具；仅可信本地环境按白名单开启。
ENABLE_AUTO_CODE_TOOLS=false
CODE_TOOL_ALLOWLIST=
# HTTP 工具可信外部域名白名单，逗号分隔；默认空，仍会阻断私网/本机/容器服务名。
HTTP_TOOL_ALLOWED_HOSTS=
# 沙箱最小资源限制；SaaS/多租户需替换为 gVisor/nsjail 等强隔离。
SANDBOX_MAX_CONCURRENCY=2
SANDBOX_CPU_SECONDS=5
SANDBOX_MEMORY_MB=256
SANDBOX_MAX_OPEN_FILES=64
SANDBOX_MAX_PROCESSES=32
